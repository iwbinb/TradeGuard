{
  "name": "tradeguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "predev": "npm run build",
    "dev:web": "vite",
    "dev:api": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 migrations apply tradeguard --local --env=\"\"",
    "prepare:deployment": "npm run contracts:build && tsx scripts/prepare-deployment.ts",
    "build": "vite build",
    "preview": "vite preview",
    "types": "wrangler types server/env.d.ts --strict-vars false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:contracts": "forge test",
    "test:fork": "tsx scripts/test-fork.ts",
    "contracts:build": "forge build && node scripts/export-contracts.mjs",
    "check": "npm run contracts:build && npm run typecheck && npm run test && npm run test:contracts && npm run build && npm run test:worker",
    "check:deploy": "wrangler deploy --dry-run --env production",
    "check:protocol": "tsx scripts/check-protocol.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@somnia-chain/markets-sdk": "0.29.0",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "1.35.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.55.17",
    "vite": "6.4.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260902.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
